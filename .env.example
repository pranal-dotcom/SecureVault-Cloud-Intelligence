# ==============================================================================
# SecureVault - Production Environment Configuration Template
# ==============================================================================

# General Configuration
DOMAIN_NAME=vault.example.com
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=ChangeMeWithAStrongPassword123!

# MariaDB (Database) Configuration
MYSQL_ROOT_PASSWORD=SuperSecretRootPasswordChangeMe!
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=SuperSecretDbPasswordChangeMe!

# Redis Cache Configuration
REDIS_HOST_PASSWORD=SuperSecretRedisPasswordChangeMe!

# Nextcloud Performance & Runtime Tunables
PHP_MEMORY_LIMIT=2048M
PHP_UPLOAD_LIMIT=10G
OVERWRITEPROTOCOL=https
OVERWRITEHOST=localhost
NEXTCLOUD_TRUSTED_DOMAINS=vault.example.com localhost 127.0.0.1
TRUSTED_PROXIES=reverse-proxy 172.16.0.0/12 10.0.0.0/8 192.168.0.0/16
DEFAULT_PHONE_REGION=US

# ==============================================================================
# Phase 2: AWS S3 Primary Object Storage & KMS Encryption Configuration
# ==============================================================================
# Provisioned via scripts/setup_aws_s3_kms.sh or scripts/setup_aws_s3_kms.ps1
AWS_ACCESS_KEY_ID=AKIAEXAMPLEACCESSKEY
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
S3_BUCKET_NAME=securevault-primary-storage-example
KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012

# Nextcloud ObjectStore Explicit Configuration
OBJECTSTORE_S3_BUCKET=securevault-primary-storage-example
OBJECTSTORE_S3_REGION=us-east-1
OBJECTSTORE_S3_KEY=AKIAEXAMPLEACCESSKEY
OBJECTSTORE_S3_SECRET=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
OBJECTSTORE_S3_USE_SSE=true

# Local / Mock S3 (MinIO) Configuration (Optional)
# If testing without AWS credentials, leave S3_BUCKET_NAME / OBJECTSTORE_S3_BUCKET empty
# to use local volume storage, or set the parameters below to connect to local MinIO:
# OBJECTSTORE_S3_HOST=minio
# OBJECTSTORE_S3_PORT=9000
# OBJECTSTORE_S3_PATH_STYLE=true
# OBJECTSTORE_S3_SSL=false
OBJECTSTORE_S3_HOST=
OBJECTSTORE_S3_PORT=
OBJECTSTORE_S3_PATH_STYLE=false
OBJECTSTORE_S3_SSL=true
